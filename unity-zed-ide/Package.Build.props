<Project>
  <PropertyGroup>
    <_UnityZedEditorImportBuildProps>false</_UnityZedEditorImportBuildProps>
    <_UnityZedEditorImportBuildProps Condition="'$(UnityZedEditorBuildPropsImported)' == ''">true</_UnityZedEditorImportBuildProps>
    <UnityZedEditorBuildPropsImported>true</UnityZedEditorBuildPropsImported>
    <UnityZedEditorActive Condition="'$(UnityZedEditorActive)' == ''">false</UnityZedEditorActive>
  </PropertyGroup>

  <Import Project="$(SolutionDir)Library/ZedEditor/MSBuild/ZedEditor.Generated.props"
          Condition="'$(_UnityZedEditorImportBuildProps)' == 'true' And Exists('$(SolutionDir)Library/ZedEditor/MSBuild/ZedEditor.Generated.props')" />

  <!-- Unity.EntryPoint.Sdk imports package props before setting IsEntryPointProject. -->
  <PropertyGroup Condition="'$(_UnityZedEditorImportBuildProps)' == 'true' And '$(UnityZedEditorActive)' == 'true' And '$(DesignTimeBuild)' == 'true' And '$(IsEntryPointProject)' != 'true' And '$(MSBuildProjectName)' != 'Main.EntryPoint'">
    <NoWarn>$(NoWarn);USG0001</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(_UnityZedEditorImportBuildProps)' == 'true' And Exists('$(SolutionDir)Library/ZedEditor/MSBuild/ZedEditor.Generated.props')">
    <_UnityZedEditorGeneratedProps Include="$(SolutionDir)Library/ZedEditor/MSBuild/ZedEditor.Generated.props" />
    <FastUpToDateCheckBuildInput Include="_UnityZedEditorGeneratedProps" />
  </ItemGroup>

  <ItemGroup Condition="'$(_UnityZedEditorImportBuildProps)' == 'true' And '$(UnityZedEditorActive)' == 'true' And '$(IsEntryPointProject)' != 'true' And '$(MSBuildProjectName)' != 'Main.EntryPoint'">
    <ProjectCapability Include="Unity" />
    <ProjectCapability Include="EnableOnDemandExcludedFolderLoading" />
  </ItemGroup>
</Project>
